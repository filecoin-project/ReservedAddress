// storage layout:
// 0x0XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX: owner[address]: [pendingClaimTime12, owner20]
// 0x1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX: salt[address]
// 0x2XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX: getcode[address]


JUMPI(table, CALLDATASIZE)
// fallback: getcode
MSTORE(MSIZE, SLOAD(ADD(0x20000000000000000000000000000000000000000, CALLER)))
RETURN(CALLDATASIZE, MSIZE)


table:
SHR(128, CALLDATALOAD(MSIZE)) // method

// assert that first arg is valid address

// binary search:

// 0x06fdde03 name()
// 0x1b8b921d call(address,bytes)
// 0x5a628525 reveal(address,bytes32)
// 0x6352211e ownerOf(uint256)
// 0x95d89b41 symbol()
// 0xc87b56dd tokenURI(uint256)
// 0xe75179a4 reserve(address) 
// 0xf75f9f7b dispute(address)


JUMPI(gta, LT(0xa0000000000000000000000000000000, DUP1))
JUMPI(call, EQ(0x1b8b921d000000000000000000000000, DUP1))
JUMPI(deploy, EQ(0x545e7c61000000000000000000000000, DUP1))
JUMPI(reveal, EQ(0x5a628525000000000000000000000000, DUP1))
JUMPI(ownerof, EQ(0x6352211e000000000000000000000000, DUP1))
JUMPI(totalsupply, EQ(0x18160ddd000000000000000000000000, DUP1))
JUMPI(symbol, EQ(0x95d89b41000000000000000000000000, DUP1))
JUMPI(name, EQ(0x06fdde03000000000000000000000000, DUP1))
REVERT(0, MSIZE)

gta:
JUMPI(transfer, EQ(0xba45b0b8000000000000000000000000, DUP1))
JUMPI(reserve, EQ(0xe75179a4000000000000000000000000, DUP1))
JUMPI(dispute, EQ(0xf75f9f7b000000000000000000000000, DUP1))
JUMPI(tokenuri, EQ(0xc87b56dd000000000000000000000000, DUP1))
REVERT(0, MSIZE)

badhash:
MSTORE(MSIZE, 0x6261642068617368000000000000000000000000000000000000000000000000)
REVERT(0, MSIZE)

dispute:
// dispute(address)
OR(CALLER, SHL(160, TIMESTAMP)) // next_expiring_pending_owner
CALLDATALOAD(4)
SHR(160, SLOAD(DUP1)) // when claimed
JUMPI(disputechecktime, DUP1)
// fallthrough to accessdenied

accessdenied:
MSTORE(0, 0x30cd7471)
REVERT(28, 4)

backoff:
MSTORE(0, 0xfaf3f41e)
REVERT(28, 4)

noteoa:
MSTORE(MSIZE, 0x6e6f7420656f6100000000000000000000000000000000000000000000000000)
REVERT(0, MSIZE)

deploy:
// deploy(address,address)

// check owner
CALLVALUE
CALLDATALOAD(4) // target
JUMPI(accessdenied, XOR(CALLER, SLOAD(DUP1)))

// prepare getcode
SSTORE(ADD(0x20000000000000000000000000000000000000000, DUP2), CALLDATALOAD(36))

// create2
PUSH32 { init: assemble src/Init.evm }
0 MSTORE
0x10000000000000000000000000000000000000000 ADD
CREATE2(SELFBALANCE, 0, MSIZE, SLOAD(DUP1))
JUMPI(setcodecheckcodesize, DUP1)

// create failed
MSTORE(MSIZE, 0x637265617465206661696c656400000000000000000000000000000000000000)
REVERT(0, MSIZE)

call:
CALLDATALOAD(68) // calldata.length
CALLDATALOAD(4) // target
JUMPI(accessdenied, XOR(CALLER, SLOAD(DUP1)))
CALLDATACOPY(RETURNDATASIZE, 100, DUP2)
JUMPI(stop, CALL(GAS, DUP6, CALLVALUE, RETURNDATASIZE, DUP4, RETURNDATASIZE, MSIZE))
REVERT(0, RETURNDATASIZE)

stop:
STOP

reserve:
// reserve(address)
OR(CALLER, SHL(160, TIMESTAMP))  // expiring_pending_owner
CALLDATALOAD(4)  // target
JUMPI(accessdenied, SLOAD(DUP1))
SSTORE
STOP

disputechecktime:
// stack is: next_expiring_pending_owner target claimtime
SUB(TIMESTAMP, 86400) // expiry of 1 day
JUMPI(backoff, LT)
SSTORE
STOP

reveal:
// reveal(address,bytes32)

CALLER
CALLDATALOAD(4) // target
LOG4(MSIZE, MSIZE, 0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef, MSIZE, CALLER, DUP1)

MSTORE(MSIZE, 0xff000000000000c57cf0a1f923d44527e703f1ad70)
CALLDATALOAD(36)
SSTORE(ADD(0x10000000000000000000000000000000000000000, DUP3), DUP1) // store salt
MSIZE MSTORE
MSTORE(MSIZE, 0xbcbdfadcc59d9dc57408c9c0b8c471bde38115ed725ac4bbe1308d01651d5d99) // sha3(init.evm)
JUMPI(badhash, XOR(AND(0xffffffffffffffffffffffffffffffffffffffff, SHA3(11, 85)), DUP1))

JUMPI(accessdenied, XOR(CALLER, AND(0xffffffffffffffffffffffffffffffffffffffff, SLOAD(DUP1))))
SSTORE
STOP


transfer:
// transfer(address, address)
CALLDATALOAD(4) // recipient
JUMPI(noteoa, XOR(0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470, EXTCODEHASH(DUP1)))
AND(0xffffffffffffffffffffffffffffffffffffffff, CALLDATALOAD(36)) // target
JUMPI(accessdenied, XOR(CALLER, SLOAD(DUP1)))
LOG4(MSIZE, MSIZE, 0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef, CALLER, DUP3, DUP1)
SSTORE
STOP

setcodecheckcodesize:
// stack is: 0 salt[target] target
JUMPI(cleanup, EXTCODESIZE)
REVERT(0, MSIZE)

cleanup:
// cleanup getcode
0x10000000000000000000000000000000000000000 ADD
SSTORE
STOP


symbol:
// "CODE"
MSTORE(MSIZE, 32)
MSTORE(MSIZE, 4)
MSTORE(MSIZE, 0x434f444500000000000000000000000000000000000000000000000000000000)
RETURN(RETURNDATASIZE, MSIZE)


name:
// "Contract"
MSTORE(MSIZE, 32)
MSTORE(MSIZE, 8)
MSTORE(MSIZE, 0x436f6e7472616374000000000000000000000000000000000000000000000000)
RETURN(RETURNDATASIZE, MSIZE)

tokenuri:
// https://etherscan.io/address/0x<tokenid>
MSTORE(MSIZE, 32)
MSTORE(MSIZE, 71)  // 31 + 40
// https://etherscan.io/address/0x
MSTORE(MSIZE, 0x68747470733a2f2f65746865727363616e2e696f2f616464726573732f307800)
CALLDATALOAD(4) // token
135
loop:
AND(0xf, DUP2) // nibble
// 48 is 0, 97 is a (=10), 49-10=39
ADD(48, MUL(39, LT(0x9, DUP1)))
MSTORE8(DUP2, ADD)
0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff ADD // outIndex -= 1
SWAP1 4 SHR SWAP1 // token >>= 4
JUMPI(loop, LT(95, DUP1))
RETURN(RETURNDATASIZE, 136)

ownerof:
// ownerOf(uint256)
MSTORE(MSIZE, AND(0xffffffffffffffffffffffffffffffffffffffff, SLOAD(CALLDATALOAD(4))))
RETURN(RETURNDATASIZE, MSIZE)

totalsupply:
// totalSupply()
MSTORE(MSIZE, 10000000000000000000000000000000000000000)
RETURN(RETURNDATASIZE, MSIZE)
