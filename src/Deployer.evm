// storage layout:
//  0x0XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX: owner[address]: [pendingClaimTime12, owner20]
//  0x1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX: salt[address]
//  0x2XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX: getApproved[address]
//  0x3XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX: balanceOf[address]
// >0x3ffffffffffffffffffffffffffffffffffffffff: isApprovedForAll<owner ++ operator>


JUMPI(table, CALLDATASIZE)
JUMPI(unexpectedvalue, CALLVALUE)
// fallback: getcode
MSTORE(MSIZE, TLOAD(CALLER))
RETURN(0, MSIZE)

unexpectedvalue:
// error UnexpectedValue()
MSTORE(0, 0x123146a6)
REVERT(28, 4)


table:
SHR(128, CALLDATALOAD(MSIZE)) // method

// shifting only 128 lets us assert that the first arg is valid address for free

// binary search:

// 0x01ffc9a7 supportsInterface(bytes4)
// 0x06fdde03 name()
// 0x081812fc getApproved(uint256)
// 0x095ea7b3 approve(address,uint256)
// 0x18160ddd totalSupply()
// 0x1b8b921d call(address,bytes)
// 0x23b872dd transferFrom(address,address,uint256)
// 0x42842e0e safeTransferFrom(address,address,uint256)
// 0x4f6ccce7 tokenByIndex(uint256)
// 0x545e7c61 deploy(address,address)
// 0x5a628525 reveal(address,bytes32)
// 0x6352211e ownerOf(uint256)
// 0x70a08231 balanceOf(address)
// 0x95d89b41 symbol()
// 0xa22cb465 setApprovalForAll(address,bool)
// 0xb88d4fde safeTransferFrom(address,address,uint256,bytes)
// 0xc87b56dd tokenURI(uint256)
// 0xe75179a4 reserve(address)
// 0xe985e9c5 isApprovedForAll(address,address)
// 0xef964f3b reservation(address)
// 0xf75f9f7b dispute(address)


JUMPI(gta, LT(0xa0000000000000000000000000000000, DUP1))
JUMPI(call, EQ(0x1b8b921d000000000000000000000000, DUP1))
JUMPI(deploy, EQ(0x545e7c61000000000000000000000000, DUP1))
JUMPI(reveal, EQ(0x5a628525000000000000000000000000, DUP1))
JUMPI(approve, EQ(0x095ea7b3000000000000000000000000, DUP1))
JUMPI(transferfrom, EQ(0x42842e0e000000000000000000000000, DUP1))
JUMPI(transferfrom, EQ(0x23b872dd000000000000000000000000, DUP1))
JUMPI(ownerof, EQ(0x6352211e000000000000000000000000, DUP1))
JUMPI(getapproved, EQ(0x081812fc000000000000000000000000, DUP1))
JUMPI(balanceof, EQ(0x70a08231000000000000000000000000, DUP1))
JUMPI(totalsupply, EQ(0x18160ddd000000000000000000000000, DUP1))
JUMPI(symbol, EQ(0x95d89b41000000000000000000000000, DUP1))
JUMPI(name, EQ(0x06fdde03000000000000000000000000, DUP1))
96 SHR
JUMPI(supportsinterface, EQ(0x01ffc9a7, DUP1))
JUMPI(tokenbyindex, EQ(0x4f6ccce7, DUP1))
REVERT(0, MSIZE)

gta:
JUMPI(reserve, EQ(0xe75179a4000000000000000000000000, DUP1))
JUMPI(dispute, EQ(0xf75f9f7b000000000000000000000000, DUP1))
JUMPI(setapprovalforall, EQ(0xa22cb465000000000000000000000000, DUP1))
JUMPI(transferfrom, EQ(0xb88d4fde000000000000000000000000, DUP1))
JUMPI(isapprovedforall, EQ(0xe985e9c5000000000000000000000000, DUP1))
JUMPI(reservation, EQ(0xef964f3b000000000000000000000000, DUP1))
JUMPI(tokenuri, EQ(0xc87b56dd000000000000000000000000, DUP1))
REVERT(0, MSIZE)

badhash:
// error BadSalt()
MSTORE(0, 0xb6a71f7b)
REVERT(28, 4)

dispute:
// dispute(address)
OR(CALLER, SHL(160, TIMESTAMP)) // next_expiring_pending_owner
CALLDATALOAD(4)
SHR(160, SLOAD(DUP1)) // when claimed

// stack is: next_expiring_pending_owner target claim.time

// claimtime == 0 or now - day < claim.time
LT(SUB(TIMESTAMP, 86400), DUP1) // expiry of 1 day
SWAP1 ISZERO
JUMPI(reserved, OR)

// stack is: next_expiring_pending_owner target
SSTORE
STOP

reserved:
// error Reserved()
MSTORE(0, 0xfaf3f41e)
REVERT(28, 4)

accessdenied:
// error NotOwner()
MSTORE(0, 0x30cd7471)
REVERT(28, 4)

deploy:
// deploy(address,address)

// check owner
0
CALLDATALOAD(4) // target
JUMPI(accessdenied, XOR(CALLER, SLOAD(DUP1)))

// prepare getcode
TSTORE(DUP2, CALLDATALOAD(36))

// create2
PUSH32 { init: assemble src/Init.evm }
0 MSTORE
0x10000000000000000000000000000000000000000 ADD
CREATE2(CALLVALUE, 0, MSIZE, SLOAD(DUP1))
JUMPI(setcodecheckcodesize, DUP1)

// create failed
MSTORE(MSIZE, 0x637265617465206661696c656400000000000000000000000000000000000000)
REVERT(0, MSIZE)

call:
CALLDATALOAD(68) // calldata.length
CALLDATALOAD(4) // target
JUMPI(accessdenied, XOR(CALLER, SLOAD(DUP1)))
CALLDATACOPY(0, 100, DUP2)
CALL(GAS, DUP6, CALLVALUE, 0, DUP4, 0, MSIZE)
RETURNDATACOPY(0, 0, RETURNDATASIZE)
callsuccess JUMPI
REVERT(0, RETURNDATASIZE)

callsuccess:
RETURN(0, RETURNDATASIZE)

reservation:
SLOAD(CALLDATALOAD(4))
MSTORE(MSIZE, AND(0xffffffffffffffffffffffffffffffffffffffff, DUP1))
160 SHR
MSTORE(MSIZE, MUL(ADD(86400, DUP2), ISZERO(ISZERO(DUP1))))
RETURN(0, MSIZE)

reserve:
// reserve(address)
OR(CALLER, SHL(160, TIMESTAMP))  // expiring_pending_owner
CALLDATALOAD(4)  // target
JUMPI(reserved, SLOAD(DUP1))
SSTORE
STOP

reveal:
// reveal(address,bytes32)

CALLER
CALLDATALOAD(4) // target
LOG4(MSIZE, MSIZE, 0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef, MSIZE, CALLER, DUP1)

MSTORE(MSIZE, 0xff000000000000c57cf0a1f923d44527e703f1ad70)
CALLDATALOAD(36)
SSTORE(ADD(0x10000000000000000000000000000000000000000, DUP3), DUP1) // store salt
MSIZE MSTORE
MSTORE(MSIZE, 0xbcbdfadcc59d9dc57408c9c0b8c471bde38115ed725ac4bbe1308d01651d5d99) // sha3(init.evm)
JUMPI(badhash, XOR(AND(0xffffffffffffffffffffffffffffffffffffffff, SHA3(11, 85)), DUP1))

JUMPI(accessdenied, XOR(CALLER, AND(0xffffffffffffffffffffffffffffffffffffffff, SLOAD(DUP1))))

// balanceOf[msg.sender]++
OR(0x30000000000000000000000000000000000000000, CALLER)
ADD(1, SLOAD(DUP1))
SWAP1 SSTORE

SSTORE

STOP

setcodecheckcodesize:
// stack is: 0 &salt[target] target
JUMPI(cleanup, EXTCODESIZE)
REVERT(0, MSIZE)

cleanup:
// stack is: 0 &salt[target]
// cleanup salt
SSTORE
STOP


symbol:
// "CODE"
MSTORE(MSIZE, 32)
MSTORE(63, 0x04434f4445000000000000000000000000000000000000000000000000000000)
RETURN(0, MSIZE)


name:
// "Contract"
MSTORE(MSIZE, 32)
MSTORE(63, 0x08436f6e74726163740000000000000000000000000000000000000000000000)
RETURN(0, MSIZE)

tokenuri:
// tokenURI(uint256)

// https://filecoin.blockscout.com/address/0x<tokenid>
MSTORE(MSIZE, 32)
// https://filecoin.blockscout.com
MSTORE(63, 0x5268747470733a2f2f66696c65636f696e2e626c6f636b73636f75742e636f6d)
// /address/0x
MSTORE(95, 0x2f616464726573732f3078000000000000000000000000000000000000000000)
CALLDATALOAD(4) // token
145
loop:
AND(0xf, DUP2) // nibble
// 48 is 0, 97 is a (=10), 49-10=39
ADD(48, MUL(39, LT(0x9, DUP1)))
MSTORE8(DUP2, ADD)

SHR(4, AND(0xf0, DUP2)) // nibble
ADD(48, MUL(39, LT(0x9, DUP1)))
MSTORE8(SUB(DUP3, 1), ADD)
0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe ADD // outIndex -= 2
SWAP1 8 SHR SWAP1 // token >>= 8

JUMPI(loop, LT(105, DUP1))
RETURN(0, 146)

ownerof:
// ownerOf(uint256)
SLOAD(CALLDATALOAD(4))
JUMPI(ownerofvalid, MUL(DUP2, ISZERO(SHR(160, DUP1))))
// error InvalidAddress()
MSTORE(0, 0xe6c4247b)
REVERT(28, 4)

ownerofvalid:
MSTORE(MSIZE, DUP1)
RETURN(0, MSIZE)

balanceof:
// balanceOf(address)
CALLDATALOAD(4)
JUMPI(balanceofvalid, DUP1)

invalidaddress:
// error InvalidAddress()
MSTORE(0, 0xe6c4247b)
REVERT(28, 4)

balanceofvalid:
0x30000000000000000000000000000000000000000
MSTORE(0, SLOAD(OR))
RETURN(0, MSIZE)

getapproved:
// getApproved(uint256)
CALLDATALOAD(4)

JUMPI(getapprovedvalidtoken, MUL(ISZERO(SHR(160, DUP1)), SLOAD(DUP1)))
REVERT(0, 0)

getapprovedvalidtoken:
0x20000000000000000000000000000000000000000
MSTORE(0, SLOAD(OR))
RETURN(0, MSIZE)

approve:
// approve(address, uint256)
CALLDATALOAD(36) // tokenId
JUMPI(invalidaddress, SHR(160, DUP1))
CALLDATALOAD(4) // operator
SLOAD(DUP2) // reservation
JUMPI(approveauthorized, EQ(CALLER, DUP1)) // caller is owner
JUMPI(accessdenied, SHR(160, DUP1))
MSTORE(20, CALLER)
MSTORE(0, DUP1)
JUMPI(accessdenied, ISZERO(SLOAD(ADD(0x40000000000000000000000000000000000000000, MOD(SHA3(12, 40), 0xfffffffffffffffffffffffc0000000000000000000000000000000000000000)))))
// caller is owner's authorized operator
// fall through

approveauthorized:
// stack is: tokenId operator owner

SSTORE(OR(0x20000000000000000000000000000000000000000, DUP4), DUP2)
0x8c5be1e5ebec7d5bd14f71427d1e84f3dd0314c0f7b2291e5b200ac8c7c3b925 0 0 LOG4
STOP

isapprovedforall:
MSTORE(0, CALLDATALOAD(16))
MSTORE(20, CALLDATALOAD(48))
MSTORE(0, SLOAD(ADD(0x40000000000000000000000000000000000000000, MOD(SHA3(0, 40), 0xfffffffffffffffffffffffc0000000000000000000000000000000000000000))))
RETURN(0, 32)

setapprovalforall:
// setApprovalForAll(address, bool)
ISZERO(ISZERO(CALLDATALOAD(36)))
MSTORE(0, DUP1)
CALLDATALOAD(4)
LOG3(0, MSIZE, 0x17307eab39ab6107e8899845ad3d59bd9653f200f220920489ca2b5937696c31, CALLER, DUP1)
20 MSTORE
MSTORE(0, CALLER)
ADD(0x40000000000000000000000000000000000000000, MOD(SHA3(12, 40), 0xfffffffffffffffffffffffc0000000000000000000000000000000000000000))
SSTORE
STOP

transferfrom:
// transferFrom(address from, address to, uint256 tokenId)
// safeTransferFrom(address from, address to, uint256 tokenId)
// safeTransferFrom(address from, address to, uint256 tokenId, bytes data)

CALLDATALOAD(68) // tokenId
JUMPI(invalidaddress, SHR(160, DUP1))
AND(0xffffffffffffffffffffffffffffffffffffffff, CALLDATALOAD(36)) // recipient
JUMPI(invalidaddress, ISZERO(DUP1))
SLOAD(DUP2) // owner

JUMPI(accessdenied, SHR(160, DUP1)) // token is reserved but unowned
JUMPI(accessdenied, XOR(CALLDATALOAD(4), DUP1)) // from must be owner
JUMPI(dotransfer, EQ(CALLER, DUP1))
JUMPI(dotransfer,
    EQ(CALLER, SLOAD(OR(0x20000000000000000000000000000000000000000, DUP3)))  // getApproved[tokenId] == msg.sender
)
MSTORE(20, CALLER)
MSTORE(0, DUP1)
JUMPI(
    accessdenied,
    ISZERO(
        SLOAD(ADD(0x40000000000000000000000000000000000000000, MOD(SHA3(12, 40), 0xfffffffffffffffffffffffc0000000000000000000000000000000000000000)))
    ) // !isApprovedForAll[owner ++ msg.sender]
)

dotransfer:
// stack is: tokenId recipient owner

// delete getApproved[tokenId]
SSTORE(OR(0x20000000000000000000000000000000000000000, DUP4), 0)

// ownerOf[tokenId] = recipient
SSTORE(DUP4, DUP2)

// balanceOf[recipient] += 1
OR(0x30000000000000000000000000000000000000000, DUP2)
ADD(1, SLOAD(DUP1))
SWAP1
SSTORE

// balanceOf[owner] -= 1
OR(0x30000000000000000000000000000000000000000, DUP1)
SUB(SLOAD(DUP2), 1)
SWAP1
SSTORE

// 0x23b872dd transferFrom(address,address,uint256)
JUMPI(emittransfer, EQ(0x23b872dd000000000000000000000000, DUP4))
JUMPI(tokenreceiver, EXTCODESIZE(DUP2))

emittransfer:
// stack is: tokenId recipient owner

// emit Transfer(from, to, tokenId)
0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef 0 0 LOG4

STOP

tokenreceiver:

// 0x42842e0e safeTransferFrom(address,address,uint256)
// 0xb88d4fde safeTransferFrom(address,address,uint256,bytes)

// stack is: tokenId recipient owner

// ERC721TokenReceiver(to).onERC721Received(operator, from, tokenId, data)
4 28 // output
MSTORE(0, 0x150b7a02)
MSTORE(32, CALLER)
MSTORE(MSIZE, DUP3)
MSTORE(MSIZE, DUP5)
MSTORE(MSIZE, MSIZE)

JUMPI(tokenreceiverdatacopy, EQ(0xb88d4fde000000000000000000000000, DUP6))

164 // input size

JUMP(calltokenreceiver)

tokenreceiverdatacopy:
// 0xb88d4fde safeTransferFrom(address,address,uint256,bytes)

ADD(4, CALLDATALOAD(100)) // offset
ADD(32, CALLDATALOAD(DUP1)) // copysize with len
DUP1 SWAP2
MSIZE CALLDATACOPY // copy len and size

132 ADD // input size

calltokenreceiver:
DUP2 0 DUP7 GAS
JUMPI(checkret, CALL)
RETURNDATACOPY(0, 0, RETURNDATASIZE)
REVERT(0, RETURNDATASIZE)

checkret:
JUMPI(emittransfer, EQ(MLOAD(0), 0x150b7a02))
MSTORE(0, 0x2971e53b)
REVERT(28, 4)

supportsinterface:
// supportsInterface(bytes4)
SHR(224, CALLDATALOAD(4))
EQ(0x5b5e139f, DUP1)    // IERC721Metadata
EQ(0x80ac58cd, DUP2) OR // IERC721
EQ(0x01ffc9a7, DUP2)    // IERC165
MSTORE(0, OR)
RETURN(0, 32)

totalsupply:
// totalSupply()
MSTORE(MSIZE, 0x10000000000000000000000000000000000000000)
RETURN(0, MSIZE)

tokenbyindex:
// tokenByIndex(uint256)
CALLDATALOAD(4)
JUMPI(invalidaddress, SHR(160, DUP1))
MSTORE(MSIZE, DUP1)
RETURN(0, MSIZE)
