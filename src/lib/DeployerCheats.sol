pragma solidity ^0.8.36;

import {Vm} from "forge-std/Vm.sol";

import {DEPLOYER_CREATOR} from "./IDeployerLibrary.sol";

bytes constant DEPLOY_RAW_TX =
    hex"";

library DeployerCheats {
    function deployDeployer(Vm vm) internal {
        vm.deal(DEPLOYER_CREATOR, 0.2 ether);
        vm.broadcastRawTransaction(DEPLOY_RAW_TX);
    }
}
